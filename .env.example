NODE_ENV=development
PORT=9999
LOG_LEVEL=debug

# --- Local dev (docker-compose) ---
# Owner connection: migrations, the test harness, the superadmin plane. It
# owns the tables, so RLS does NOT protect anything read through it.
DATABASE_URL=postgresql://hospital:hospital@localhost:5438/hospital_dev
TEST_DATABASE_URL=postgresql://hospital:hospital@localhost:5439/hospital_test
REDIS_URL=redis://localhost:6383

# The unprivileged runtime role (db/roles.sql). Every tenant request goes
# through this connection, inside a transaction that has set app.facility_id.
# MUST be a different role from DATABASE_URL; the app refuses to boot
# otherwise, because the owner bypasses RLS.
APP_DATABASE_URL=postgresql://hospital_app:hospital_app@localhost:5438/hospital_dev

# Better Auth's own role (db/roles.sql): the only one that can read sessions,
# password hashes and verification tokens. Must differ from both roles above.
AUTH_DATABASE_URL=postgresql://hospital_auth:hospital_auth@localhost:5438/hospital_dev

# --- Auth (Better Auth) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:9999

# --- Email (Resend) --- set BOTH or neither. Required in production.
# When set, a person must have verified their address before they can sign in.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- Staff app and proxies ---
# The staff app origin that emailed links point at.
APP_URL=http://localhost:3000
# Your own proxies in front of the API (0 = exposed directly). See src/env.ts.
TRUST_PROXY_HOPS=0
TRUSTED_PROXY_IPS=
