NODE_ENV=test
PORT=9999
LOG_LEVEL=silent

# The disposable tmpfs Postgres on :5439 (docker-compose.yml). DATABASE_URL is
# ignored in test mode: env.ts resolves it to TEST_DATABASE_URL.
DATABASE_URL=postgresql://hospital:hospital@localhost:5439/hospital_test
TEST_DATABASE_URL=postgresql://hospital:hospital@localhost:5439/hospital_test
# The unprivileged role RLS actually applies to (db/roles.sql). The isolation
# tests mean nothing without it.
APP_DATABASE_URL=postgresql://hospital_app:hospital_app@localhost:5439/hospital_test
TEST_APP_DATABASE_URL=postgresql://hospital_app:hospital_app@localhost:5439/hospital_test
# Better Auth's own role (db/roles.sql): the only one that can read sessions.
AUTH_DATABASE_URL=postgresql://hospital_auth:hospital_auth@localhost:5439/hospital_test
TEST_AUTH_DATABASE_URL=postgresql://hospital_auth:hospital_auth@localhost:5439/hospital_test
REDIS_URL=redis://localhost:6383

# Not a real secret: test fixture only.
BETTER_AUTH_SECRET=test-secret-not-used-in-production-0123456789
BETTER_AUTH_URL=http://localhost:9999

# app.request() has no socket, so tests declare one trusted edge to make
# X-Forwarded-For meaningful. Production defaults to 0.
TRUST_PROXY_HOPS=1
APP_URL=http://localhost:3000

# The local storage driver writes here; .storage/ is gitignored.
STORAGE_LOCAL_DIR=.storage/test
