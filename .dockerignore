# Never bake secrets into an image.
.env
.env.*
!.env.example

node_modules
dist
coverage

.git
.github
.vscode
.idea
.claude

# Local-only tooling and docs.
docker-compose.yml
dev.sh
*.md
LICENSE

# Tests don't ship; the runtime image has no dev dependencies to run them.
**/*.test.ts
src/test

*.log
.DS_Store
